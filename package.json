{
  "name": "seven-cities",
  "version": "1.0.0",
  "description": "An unofficial fan tribute to The Seven Cities of Gold (1984)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "check": "tsc && vitest run && vite build && node scripts/check-dist.mjs"
  },
  "keywords": [
    "game",
    "canvas",
    "typescript"
  ],
  "author": "thescottybe",
  "license": "MIT",
  "repository": "github:TheScottyB/seven-cities",
  "bugs": "https://github.com/TheScottyB/seven-cities/issues",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
